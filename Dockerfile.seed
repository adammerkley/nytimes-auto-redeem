# Seed image: the normal image plus a virtual desktop and noVNC, for logging in
# once on a headless host (Unraid, NAS, VPS). Build the main image first:
#   docker build -t nytimes-redeem .
#   docker build -f Dockerfile.seed -t nytimes-redeem-seed .
FROM nytimes-redeem
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    x11vnc novnc websockify fluxbox && rm -rf /var/lib/apt/lists/*
COPY seed-entrypoint.sh /seed-entrypoint.sh
RUN chmod +x /seed-entrypoint.sh
ENTRYPOINT ["/seed-entrypoint.sh"]
