# Copy this file to .env and fill it in. No quotes around values.
# Keep .env private: chmod 600 .env, and never commit it.

# NY Times account that receives the access
NYTIMES_EMAIL=you@example.com
NYTIMES_PASSWORD=your-nyt-password

# Scottsdale Public Library login: exactly what you type in "Barcode or Username"
LIBRARY_CARD_NUMBER=your-barcode-or-username
LIBRARY_PIN=your-library-pin

# Optional: encrypt the saved cookie file. Generate with: openssl rand -base64 32
# COOKIE_ENCRYPTION_KEY=

# Optional overrides (the defaults already point at the Scottsdale Public Library)
# LIBRARY_LOGIN_URL=https://scottsdale.polarislibrary.com/polaris/logon.aspx
# LIBRARY_LINK_URL=https://scottsdale.polarislibrary.com/polaris/Search/misc/esources.aspx?Target=1557
# TZ=America/Phoenix

# Optional fallback only. Normally the gift code is read from the library redirect.
# NYTIMES_GIFT_CODE=
